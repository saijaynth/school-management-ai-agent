# ================= School Management AI Chatbot =================
# Copy this file to `.env` (project root) and fill in the real values.

# --- PostgreSQL -------------------------------------------------
# Local: postgresql://postgres:postgres@localhost:5432/school_db
# Remote (Neon Free Postgres): postgresql://user:password@ep-xyz.neon.tech/school_db?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/school_db
DB_SCHEMA=school
STATEMENT_TIMEOUT_MS=5000

# --- LLM Provider ------------------------------------------------
# local (Default - Zero API keys, in-memory ML model) | openai | anthropic | gemini | ollama | custom
LLM_PROVIDER=local
LLM_MODEL=scikit-learn-ml-agent

# Optional External API overrides (only needed if using external cloud LLMs):
LLM_BASE_URL=
LLM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Server Ports ------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=*

# --- Hugging Face (Optional) --------------------------------------
HF_ACCESS_TOKEN=
